# TitouneOS — Environment Configuration

# --- NextAuth ---
NEXTAUTH_URL=https://titounex.vercel.app
NEXTAUTH_SECRET=__GENERATED_SECRET__
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend (FastAPI) ---
NEXT_PUBLIC_BACKEND_URL=https://titounex-backend.vercel.app

# --- Database ---
DATABASE_URL=

# --- App ---
NEXT_PUBLIC_APP_NAME=TitouneOS
NEXT_PUBLIC_APP_URL=https://titounex.vercel.app

# --- Stripe (Billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- LLM Gateway ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001

# Renseignez ces variables sur Vercel Dashboard > Settings > Environment Variables
