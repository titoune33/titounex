generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

// RH Specific Enums
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
  TEMPORARY
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
  RETIRED
}

enum LeaveType {
  VACATION
  SICK
  MATERNITY
  PATERNITY
  RTT
  TRAINING
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RecruitmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FILLED
}

enum CandidateStatus {
  APPLIED
  SCREENED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  ARCHIVED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  HR
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentType {
  CONTRACT
  PAYSLIP
  IDENTIFICATION
  CERTIFICATE
  EVALUATION
  OTHER
}

// ============================================
// AUTHENTICATION MODELS (NextAuth)
// ============================================

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole           @default(USER)
  tier          SubscriptionTier   @default(FREE)
  stripeCustomerId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  accounts      Account[]
  sessions      Session[]
  teams         TeamMember[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  
  // RH Relations
  employee      Employee?
  managedTeams  Team[]            @relation("TeamOwner")
  candidates    Candidate[]
  documents     Document[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// SUBSCRIPTION & TEAM MODELS
// ============================================

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  owner   User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]
  
  // RH: Team can have departments
  departments Department[]
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   TeamRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  stripeSubscriptionId String         @unique
  stripePriceId    String
  status           SubscriptionStatus @default(ACTIVE)
  tier             SubscriptionTier   @default(PRO)
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean           @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  key        String   @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// RH SPECIFIC MODELS
// ============================================

// Departments within a team/company
model Department {
  id          String       @id @default(cuid())
  name        String
  description String?
  teamId      String
  managerId   String?
  budget      Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  manager  User?          @relation(fields: [managerId], references: [id])
  employees Employee[]
  
  @@unique([teamId, name])
}

// Employee profile (extends User)
model Employee {
  id              String           @id @default(cuid())
  userId          String           @unique
  employeeId      String           @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  phone           String?
  address         String?
  city            String?
  postalCode      String?
  country         String?
  
  // Employment details
  hireDate        DateTime
  employmentType  EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  jobTitle        String
  departmentId    String?
  managerId       String?
  salary          Float?
  hourlyRate      Float?
  
  // Bank information
  bankName        String?
  bankAccount     String?
  bankRouting     String?
  
  // Tax information
  taxId           String?
  taxStatus       String?
  
  // Emergency contact
  emergencyName   String?
  emergencyPhone  String?
  emergencyRelationship String?
  
  // timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User               @relation("EmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  department  Department?        @relation(fields: [departmentId], references: [id])
  manager     User?              @relation("EmployeeManager", fields: [managerId], references: [id])
  leaveRequests LeaveRequest[]
  payrolls     Payroll[]
  documents    Document[]
  
  @@index([userId])
  @@index([departmentId])
}

// Leave Types configuration per company
model CompanyLeavePolicy {
  id          String       @id @default(cuid())
  teamId      String
  leaveType   LeaveType
  annualDays  Int
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, leaveType])
}

// Leave Requests
model LeaveRequest {
  id          String       @id @default(cuid())
  employeeId  String
  leaveType   LeaveType
  startDate   DateTime
  endDate     DateTime
  halfDayStart Boolean      @default(false)
  halfDayEnd   Boolean      @default(false)
  totalDays   Float
  reason      String?
  notes       String?
  status      LeaveStatus   @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  rejectedReason String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver    User?        @relation(fields: [approvedBy], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

// Recruitment positions
model Recruitment {
  id          String       @id @default(cuid())
  teamId      String
  title       String
  description String
  requirements String
  niceToHave  String?
  location    String?
  salaryRange String?
  employmentType EmploymentType @default(FULL_TIME)
  status      RecruitmentStatus @default(DRAFT)
  publishedAt DateTime?
  closedAt    DateTime?
  deadline    DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  candidates  Candidate[]
  
  @@index([teamId])
  @@index([status])
}

// Job Candidates
model Candidate {
  id          String       @id @default(cuid())
  recruitmentId String?
  firstName   String
  lastName    String
  email       String
  phone       String?
  linkedIn    String?
  portfolio   String?
  resume      String?
  coverLetter String?
  notes       String?
  status      CandidateStatus @default(APPLIED)
  source      String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  recruitment Recruitment? @relation(fields: [recruitmentId], references: [id])
  interviews  Interview[]
  
  @@index([recruitmentId])
  @@index([email])
  @@index([status])
}

// Interviews
model Interview {
  id          String       @id @default(cuid())
  candidateId String
  recruitmentId String?
  type        InterviewType
  scheduledAt DateTime
  duration    Int
  location    String?
  interviewer String
  notes       String?
  rating      Int?
  feedback    String?
  status      InterviewStatus @default(SCHEDULED)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruitment Recruitment? @relation(fields: [recruitmentId], references: [id])
  interviewerUser User     @relation(fields: [interviewer], references: [id])

  @@index([candidateId])
  @@index([interviewer])
  @@index([scheduledAt])
}

// Payroll records
model Payroll {
  id          String       @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  baseSalary  Float
  bonuses     Float        @default(0)
  deductions  Float        @default(0)
  netSalary   Float
  tax         Float
  socialCharges Float
  paymentDate DateTime?
  status      String       @default("pending")
  notes       String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
}

// HR Documents
model Document {
  id          String       @id @default(cuid())
  employeeId  String?
  userId      String?
  teamId      String
  type        DocumentType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int
  expiryDate  DateTime?
  status      String       @default("active")
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([employeeId])
  @@index([type])
}

// ============================================
// ANALYTICS & AUDIT
// ============================================

model AuditLog {
  id          String       @id @default(cuid())
  userId      String?
  action      String
  model       String
  recordId    String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime     @default(now())

  user        User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([model])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String       @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String
  read        Boolean      @default(false)
  actionUrl   String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
